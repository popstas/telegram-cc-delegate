# Template: deploy/install.sh replaces @NODE@ and @APP_DIR@ and installs it to ~/.config/systemd/user.
[Unit]
Description=telegram-delegate router (Telegram bot <-> Claude Code channel sessions)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=@NODE@ @APP_DIR@/src/router/main.ts
WorkingDirectory=@APP_DIR@
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
