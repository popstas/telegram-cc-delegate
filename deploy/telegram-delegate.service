[Unit]
Description=telegram-delegate router (Telegram bot <-> Claude Code channel sessions)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/env node %h/projects/js/telegram-delegate/src/router/main.ts
WorkingDirectory=%h/projects/js/telegram-delegate
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
